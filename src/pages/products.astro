---
import { existsSync, readdirSync } from 'node:fs';
import { join } from 'node:path';
import Layout from '../layouts/Layout.astro';

const imagesDirectory = join(process.cwd(), 'public', 'images');
const imageExtensions = new Set(['.avif', '.bmp', '.gif', '.jpeg', '.jpg', '.png', '.svg', '.webp']);

const images = existsSync(imagesDirectory)
	? readdirSync(imagesDirectory, { withFileTypes: true })
			.filter(
				(entry) =>
					entry.isFile() &&
					imageExtensions.has(entry.name.slice(entry.name.lastIndexOf('.')).toLowerCase()),
			)
			.map((entry) => ({
				src: `/images/${encodeURIComponent(entry.name)}`,
				alt: entry.name.replace(/\.[^.]+$/, '').replace(/[-_]+/g, ' '),
			}))
			.sort((a, b) => a.alt.localeCompare(b.alt))
	: [];
---

<Layout title="Products">
	<main class="products">
		<header class="page-header">
			<p class="eyebrow">Our collection</p>
			<h1>Products</h1>
			<p class="intro">Explore our range of products.</p>
		</header>

		{images.length > 0 ? (
			<section class="product-grid" aria-label="Product images">
				{images.map((image) => (
					<figure class="product-card">
						<img src={image.src} alt={image.alt} loading="lazy" />
						<figcaption>{image.alt}</figcaption>
					</figure>
				))}
			</section>
		) : (
			<p class="empty-state">
				No product images found. Add images to the <code>public/images</code> folder.
			</p>
		)}
	</main>
</Layout>

<style>
	.products {
		box-sizing: border-box;
		max-width: 1200px;
		min-height: 100%;
		margin: 0 auto;
		padding: clamp(2rem, 6vw, 5rem) clamp(1rem, 4vw, 2.5rem);
		color: #18212f;
		font-family: Inter, ui-sans-serif, system-ui, sans-serif;
	}

	.page-header {
		margin-bottom: 2rem;
	}

	.eyebrow {
		margin: 0 0 0.5rem;
		color: #657187;
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	h1 {
		margin: 0;
		font-size: clamp(2rem, 5vw, 3rem);
		letter-spacing: -0.04em;
	}

	.intro {
		margin: 0.75rem 0 0;
		color: #657187;
	}

	.product-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 220px), 1fr));
		gap: 1.25rem;
	}

	.product-card {
		overflow: hidden;
		margin: 0;
		border: 1px solid #e5e9ef;
		border-radius: 0.75rem;
		background: #fff;
	}

	.product-card img {
		display: block;
		width: 100%;
		aspect-ratio: 4 / 3;
		object-fit: contain;
		background: #f6f7f9;
	}

	.product-card figcaption {
		padding: 0.9rem 1rem;
		font-size: 0.95rem;
		font-weight: 600;
		text-transform: capitalize;
	}

	.empty-state {
		padding: 1.25rem;
		border-radius: 0.75rem;
		background: #f6f7f9;
		color: #657187;
	}

	code {
		color: #18212f;
	}
</style>
